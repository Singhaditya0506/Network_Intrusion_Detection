   "source": [
    "# 11. Handling Class Imbalance with SMOTE\n",
    "\n",
    "SMOTE is applied only to the training set to generate synthetic minority examples without contaminating the test set."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "1ed8831b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Before SMOTE: {'normal': 403696, 'neptune': 159059, 'satan': 3513, 'smurf': 2105, 'portsweep': 2075, 'nmap': 1088, 'attack_back': 678, 'guess_password': 37, 'buffer_overflow': 21, 'rootkit': 7, 'ftp_write': 6}\n",
      "After SMOTE: {'normal': 403696, 'neptune': 159059, 'attack_back': 5000, 'ftp_write': 5000, 'rootkit': 5000, 'guess_password': 5000, 'buffer_overflow': 5000, 'satan': 3513, 'smurf': 2105, 'portsweep': 2075, 'nmap': 1088}\n"
     ]
    }
   ],
   "source": [
    "# The test set remains untouched for unbiased model evaluation\n",
    "smote = SMOTE(\n",
    "    sampling_strategy={\n",
    "        'attack_back': 5000,\n",
    "        'guess_password': 5000,\n",
    "        'buffer_overflow': 5000,\n",
    "        'rootkit': 5000,\n",
    "        'ftp_write': 5000\n",
    "    },\n",
    "    random_state=42,\n",
    "    k_neighbors=3\n",
    ")\n",
    "\n",
    "X_train_smote, y_train_smote = smote.fit_resample(X_train_scaled, y_train)\n",
    "print(\"Before SMOTE:\", y_train.value_counts().to_dict())\n",
    "print(\"After SMOTE:\", y_train_smote.value_counts().to_dict())\n"
   ]
  },
