   ],
   "source": [
    "# Keep only the useful feature columns and target; remove temporary labels and binary target\n",
    "X = attack_data.drop([\"attack\", \"attack_type\"], axis=1)\n",
    "y = attack_data[\"attack_type\"]\n",
    "\n",
    "# Remove clearly non-informative columns before modeling\n",
    "X = X.drop(columns=[\"land\", \"num_outbound_cmds\", \"wrong_fragment\"], errors=\"ignore\")\n",
    "print(\"Feature count:\", X.shape[1])\n",
    "print(\"Target distribution:\")\n",
    "print(y.value_counts())"
   ]
  },
