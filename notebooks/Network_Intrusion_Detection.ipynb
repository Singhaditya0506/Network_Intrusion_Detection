   "source": [
    "# 5. Data Cleaning\n",
    "\n",
    "This section removes non-feature columns and handles obviously inconsistent columns before model training."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "47d6ea5e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Feature count: 38\n",
      "Target distribution:\n",
