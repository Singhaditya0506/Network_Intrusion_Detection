   "metadata": {},
   "source": [
    "# 7. Feature and Target Separation\n",
    "\n",
    "The target is separated from the feature matrix before any train/test split or scaling.\n",
    "\n",
    "A simpler binary variant of the task is also available in the dataset: the `attack` column labels each record as either `normal` or `attack`. This can be used for attack detection as a binary classification problem alongside the multiclass `attack_type` task."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "f9283953",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "((817551, 38), (817551,))"
      ]
     },
     "execution_count": 26,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "X_features = X\n",
    "y_target = y\n",
    "X_features.shape, y_target.shape"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "0fc9bb63",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Binary Classification: Attack vs Normal\n",
      "              precision    recall  f1-score   support\n",
      "\n",
      "           0       1.00      1.00      1.00    173013\n",
      "           1       1.00      1.00      1.00     72253\n",
      "\n",
      "    accuracy                           1.00    245266\n",
      "   macro avg       1.00      1.00      1.00    245266\n",
      "weighted avg       1.00      1.00      1.00    245266\n",
      "\n",
      "Accuracy: 0.9978064631869072\n",
      "Macro F1: 0.9973604914938325\n"
     ]
    }
   ],
   "source": [
    "# Binary classification: normal vs attack\n",
    "# This keeps the original multiclass task intact while also supporting a simpler intrusion detection task.\n",
    "y_binary = attack_data[\"attack\"].map({\"normal\": 0, \"attack\": 1})\n",
    "X_binary = attack_data.drop([\"attack\", \"attack_type\"], axis=1)\n",
    "\n",
    "X_train_bin, X_test_bin, y_train_bin, y_test_bin = train_test_split(\n",
    "    X_binary, y_binary, test_size=0.30, random_state=42, stratify=y_binary\n",
    ")\n",
    "\n",
    "scaler_bin = StandardScaler()\n",
    "X_train_bin_scaled = scaler_bin.fit_transform(X_train_bin)\n",
    "X_test_bin_scaled = scaler_bin.transform(X_test_bin)\n",
    "\n",
    "binary_model = LogisticRegression(max_iter=1000, random_state=42)\n",
    "binary_model.fit(X_train_bin_scaled, y_train_bin)\n",
    "\n",
    "binary_pred = binary_model.predict(X_test_bin_scaled)\n",
    "print(\"Binary Classification: Attack vs Normal\")\n",
    "print(classification_report(y_test_bin, binary_pred, zero_division=0))\n",
    "print(\"Accuracy:\", accuracy_score(y_test_bin, binary_pred))\n",
    "print(\"Macro F1:\", f1_score(y_test_bin, binary_pred, average=\"macro\"))"
   ]
  },
